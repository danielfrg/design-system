{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["svelte", "vite/client", "node"],
    "paths": { "@custom/*": ["./public/v2/custom/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "public/v2/custom/**/*.ts", "public/v2/custom/**/*.svelte", "vite.config.ts"]
}
